# Optional when `letta login` has not stored credentials locally.
LETTA_API_KEY=your_letta_api_key

# Optional Letta Cloud endpoint override.
LETTA_SERVER_URL=https://api.letta.com

# Optional Microsandbox Cloud backend (default: local).
# MSB_BACKEND=cloud
# MSB_API_KEY=your_microsandbox_api_key
# MSB_API_URL=https://api.microsandbox.dev
# MSB_PROFILE=default
# MSB_COMPUTE_TYPE=shared

