FROM node:22-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    python3 \
    ripgrep \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g @letta-ai/letta-code \
  && npm cache clean --force

RUN useradd -m -u 1000 -s /bin/bash sandbox \
  && mkdir -p /workspace /home/sandbox/.letta \
  && chown -R sandbox:sandbox /workspace /home/sandbox

COPY docker/entrypoint.sh /usr/local/bin/letta-sandbox-entrypoint.sh
RUN chmod 755 /usr/local/bin/letta-sandbox-entrypoint.sh

USER sandbox
WORKDIR /workspace

ENV HOME=/home/sandbox
ENV LETTA_LISTEN_PORT=4500

EXPOSE 4500

ENTRYPOINT ["/usr/local/bin/letta-sandbox-entrypoint.sh"]
